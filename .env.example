# ---------- AI（OpenAI 兼容接口，默认 DeepSeek）----------
# 读取优先级：环境变量优先，Redis(yilin:config:ai) 兜底。
# 生产环境请「不要」配置 AI_API_KEY，让 Redis 里的值生效，这样换 Key 不必重新部署。
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_API_KEY=

# ---------- Upstash Redis（REST，与 activation-service 共用实例）----------
# Upstash 只支持 0 号库，靠 key 前缀隔离，不与 activation-service 的 code:* 冲突
UPSTASH_REDIS_REST_URL=https://ethical-ghoul-90314.upstash.io
UPSTASH_REDIS_REST_TOKEN=
REDIS_NAMESPACE=yilin:

# ---------- 限流（AI 排版接口防刷）----------
RATE_LIMIT_BURST=2/10s
RATE_LIMIT_PER_HOUR=20
RATE_LIMIT_PER_DAY=50
AI_DAILY_BUDGET=2000

# 模型思考开关：disabled（默认，更快更省）/ enabled
AI_THINKING=disabled
